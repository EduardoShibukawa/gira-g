  "tasks": [
    {
      "id": "task-01-checkout-placeorder",
      "title": "Modify the Go gRPC handler in checkout (PlaceOrder)",
      "scenario": "Scenario 6: Endpoint Change Pre-Context",
      "target_id": "service:checkout",
      "depth": 1,
      "tier": "contracts",
      "ground_truth": {
        "expected_upstream_services": ["service:cart", "service:currency", "service:email", "service:kafka", "service:payment", "service:product-catalog", "service:shipping"],
        "expected_downstream_services": ["service:accounting", "service:fraud-detection", "service:frontend"],
        "expected_affected_contracts": ["contract:CartService", "contract:CheckoutService", "contract:CurrencyService", "contract:PaymentService", "contract:ProductCatalogService", "contract:kafka:orders"],
        "anchors": [
          {"path": "src/checkout/main.go", "contains": "pb.NewCartServiceClient"},
          {"path": "src/checkout/main.go", "contains": "/send_order_confirmation"},
          {"path": "src/checkout/kafka/producer.go", "contains": "return \"orders\""}
        ],
        "notes": "EmailService and ShippingService gRPC clients are constructed but never invoked; email and shipping are called over HTTP POST. Listing those proto contracts as affected is a false positive (the task-09/10 trap)."
      }
    },
    {
      "id": "task-02-frontend-cart-http",
      "title": "Modify the frontend HTTP /cart handler",
      "scenario": "Scenario 6: Endpoint Change Pre-Context",
      "target_id": "service:frontend",
      "depth": 1,
      "tier": "contracts",
      "ground_truth": {
        "expected_upstream_services": ["service:ad", "service:cart", "service:checkout", "service:currency", "service:product-catalog", "service:recommendation", "service:shipping"],
        "expected_downstream_services": ["service:frontend-proxy", "service:mcp"],
        "expected_affected_contracts": ["contract:AdService", "contract:CartService", "contract:CheckoutService", "contract:CurrencyService", "contract:ProductCatalogService", "contract:RecommendationService"],
        "anchors": [
          {"path": "src/frontend/gateways/rpc/Cart.gateway.ts", "contains": "new CartServiceClient(CART_ADDR"},
          {"path": "compose.yaml", "contains": "- RECOMMENDATION_ADDR"}
        ],
        "notes": "quote and image-provider appear only in frontend's compose depends_on (start ordering); frontend never calls them."
      }
    },
    {
